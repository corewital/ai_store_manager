{
  "functions": {
    "build/server/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-scan",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/process-jobs",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 4 * * 0"
    }
  ]
}
