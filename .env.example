# Shopify (Sec 4)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Production MUST be your live domain (never a dead Cloudflare tunnel)
SHOPIFY_APP_URL=https://corepilotai.corewital.com
SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_customers,read_content,write_content,read_themes,write_themes,read_online_store_navigation,write_files

# Database — Turso / libSQL
# Local: file:./data/local.db
# Production (Vercel): live corepilot-ai-db ONLY — never file:
DB_PROVIDER=turso
TURSO_DATABASE_URL=file:./data/local.db
TURSO_AUTH_TOKEN=

# AI / email / cron
GEMINI_API_KEY=
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=AI Store Manager <onboarding@resend.dev>

# Admin Core (separate cookie session)
ADMIN_SESSION_SECRET=
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123!
